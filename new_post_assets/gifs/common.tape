# Shared look for every recording: about 120x35, JetBrains Mono, dark theme.
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set LineHeight 1.1
Set Width 1200
Set Height 870
Set Padding 24
Set WindowBar Colorful
Set BorderRadius 12
Set Framerate 24
Set TypingSpeed 55ms
Set Theme { "name": "codex-post", "background": "#0e0e10", "foreground": "#e6e6e6", "cursor": "#e6e6e6", "selection": "#3a3a48", "black": "#1c1c1f", "brightBlack": "#6b6b73", "red": "#ff6b6b", "brightRed": "#ff8787", "green": "#7bd88f", "brightGreen": "#9be9a8", "yellow": "#e5c07b", "brightYellow": "#f0d399", "blue": "#6ea8fe", "brightBlue": "#8fbcff", "magenta": "#c678dd", "brightMagenta": "#d69ae6", "cyan": "#56d4dd", "brightCyan": "#7fe3ea", "white": "#d6d6d6", "brightWhite": "#ffffff" }
